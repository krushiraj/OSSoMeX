{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SciBERT v2 document",
  "type": "object",
  "required": [
    "document_id",
    "text"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "text_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ]
    },
    "sections": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "page_spans": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
