{
  "base_model": "allenai/scibert_scivocab_cased",
  "base_revision": "ddf0be025f8e432a1870e34811997ba6725bf04a",
  "seed": 42,
  "epochs": 10,
  "learning_rate": 5e-05,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "microbatch_size": 2,
  "gradient_accumulation": 16,
  "max_grad_norm": 1.0,
  "min_steps_per_epoch": 10,
  "max_length": 482,
  "overlap": 64,
  "attribute_features": {
    "schema_version": "attribute-features-1",
    "segmenter_version": "sentence-regex-v2",
    "paragraph_policy": "source-metadata-or-blank-lines-v1",
    "pair_policy": "same-or-adjacent-sentence-same-paragraph-v1",
    "attribute_policy": "previous-current-next-same-paragraph-v1",
    "supervision_evidence_policy": "wholly-visible-field-evidence-v1",
    "max_length": 512,
    "markers": [
      "[SW1]",
      "[/SW1]",
      "[SW2]",
      "[/SW2]"
    ],
    "distance_clip": 128
  },
  "freeze_encoder": true
}
